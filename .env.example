# Environment Configuration Example for QuizForge AI / Project TITAN
# Copy this file to .env and fill in your developer keys.
# DO NOT commit real API keys or secrets to version control.

# AI Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Backend Service Configuration (TITAN FastAPI Backend)
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
JWT_SECRET_KEY=titan-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
