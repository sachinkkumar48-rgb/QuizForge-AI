# Dart & Flutter Monorepo Ignore Patterns

# Dart & Flutter build artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
.melos_tool/
melos_tool/
**/pubspec_overrides.yaml
pubspec_overrides.yaml

# Package pubspec.lock files in monorepo
packages/**/pubspec.lock
apps/**/pubspec.lock

# Generated code files
*.g.dart
*.freezed.dart
*.config.dart
*.mocks.dart

# Android build outputs
android/app/debug/
android/app/profile/
android/app/release/
*.apk
*.aab

# iOS & macOS build outputs
ios/Pods/
ios/Runner.xcworkspace/
macOS/Pods/
macOS/Runner.xcworkspace/
*.app
*.dSYM
*.framework
*.ipa

# Windows & Linux build outputs
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Environmental & Credentials
.env*
!.env.example
*.keystore
*.jks

# Operating System files
.DS_Store
Thumbs.db
